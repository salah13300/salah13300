DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
RESEND_API_KEY="re_xxxxxxxxxxxx"
CRON_SECRET="un-secret-aleatoire-a-generer"
# Signe les liens de connexion et cookies de session de /compte.
# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="un-secret-aleatoire-a-generer"

# Requis pour le scraper Tesla (lib/scraper.ts) : Tesla bloque les requêtes
# venant directement des serveurs (IP de datacenter). ScraperAPI route la
# requête via des IP résidentielles pour contourner ça. Créer un compte sur
# https://www.scraperapi.com et copier la clé API du dashboard.
SCRAPERAPI_KEY="ta-cle-scraperapi"

# Optionnel : active le rate limiting (checkout/subscribe/portal/auth) via
# une base Redis gratuite sur https://console.upstash.com (onglet REST API).
# Sans ces deux variables, le site fonctionne mais sans cette protection.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe — clés de TEST au début (préfixe sk_test_/whsec_test_), jamais commitées
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
STRIPE_PRICE_ID="price_xxxxxxxxxxxx" # créé dans Stripe Dashboard : produit à 3,99€/mois récurrent
APP_URL="http://localhost:3000" # à remplacer par ton domaine en production
